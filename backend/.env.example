# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

PORT=4000

# Where your static frontend is hosted (used for CORS + Ozow redirect URLs)
FRONTEND_URL=http://localhost:5500

# --- Ozow merchant credentials ---
# Get these from https://pay.ozow.com merchant admin > Settings > Site details
# Start with the TEST/sandbox SiteCode + PrivateKey Ozow gives you.
OZOW_SITE_CODE=TSTSTE0001
OZOW_PRIVATE_KEY=your_ozow_private_key_here
OZOW_API_KEY=your_ozow_api_key_here
OZOW_IS_TEST=true

# Secret used to sign the simple session tokens issued at login.
# Generate a random one, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change_this_to_a_long_random_string
